SECRET_KEY=django-insecure-placement-mgmt-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# MongoDB
MONGO_DB_NAME=placement_management
MONGO_URI=mongodb://localhost:27017/placement_management

# Email (console backend for dev)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@placement.local
